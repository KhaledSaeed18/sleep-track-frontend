# Where the Next.js server forwards /api/* requests (server-side only, read at runtime).
API_INTERNAL_URL=http://localhost:8000

# Public origin of this app, used for metadata, sitemap and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to run the app against in-browser mock handlers instead of a real API.
NEXT_PUBLIC_API_MOCKING=false
